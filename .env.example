# Default mode uses the included sample guides and needs no API key.
TRAVEL_GUIDE_MODE=sample

# Optional Hugging Face model used by app/train.py. GPT-2 is small enough for experiments.
BASE_MODEL_ID=gpt2
TRAINING_OUTPUT_DIR=artifacts/lora-adapter
MERGED_MODEL_DIR=artifacts/merged-model

# Optional hosted inference. Set TRAVEL_GUIDE_MODE=groq and add a key to use Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
